{
  "info": {
    "name": "Pedidos360 - API Gateway (evidencias)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas contra el AWS API Gateway de Pedidos360. Muestra 401 sin token, 403 sin rol y 200/201 con token valido de Azure.\n\nVariables:\n- baseUrl: Invoke URL del gateway + /prod\n- token: access token de Azure (copiar desde el navegador: F12 -> Network -> cualquier peticion al gateway -> Request Headers -> Authorization: Bearer <esto>)"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://zhvwzzntx0.execute-api.us-east-1.amazonaws.com/prod"
    },
    {
      "key": "token",
      "value": "PEGAR_ACCESS_TOKEN_DE_AZURE"
    },
    {
      "key": "notificacionesUrl",
      "value": "http://3.222.42.156:8084"
    }
  ],
  "item": [
    {
      "name": "01 - Catalogo (publico) -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/productos"
      }
    },
    {
      "name": "02 - Producto por id (publico) -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/productos/1"
      }
    },
    {
      "name": "03 - Health ms-auth (publico) -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/health"
      }
    },
    {
      "name": "04 - Carrito SIN token -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/carrito"
      }
    },
    {
      "name": "05 - Crear producto SIN token -> 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Prueba\",\n  \"precio\": 1000,\n  \"stock\": 5\n}"
        },
        "url": "{{baseUrl}}/productos"
      }
    },
    {
      "name": "06 - Carrito CON token -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/carrito"
      }
    },
    {
      "name": "07 - Agregar al carrito CON token -> 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 1\n}"
        },
        "url": "{{baseUrl}}/carrito/items"
      }
    },
    {
      "name": "08 - Checkout CON token -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/carrito/checkout"
      }
    },
    {
      "name": "09 - Perfil /auth/me CON token -> 200 (muestra roles y scopes)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "10 - Eliminar producto CON token sin rol ADMIN -> 403",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/productos/1"
      }
    },
    {
      "name": "11 - Notificaciones: enviar correo directo CON token ADMIN -> 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{notificacionesUrl}}/api/email/enviar?to=destino@correo.cl&subject=Prueba Pedidos360&body=Correo enviado desde Postman",
        "description": "Prueba directa de ms-notificaciones (EXP2): dispara el envio por Gmail. Requiere un token de un usuario ADMIN. Con MAIL_DESTINO_FORZADO el correo llega al Gmail de testing."
      }
    },
    {
      "name": "12 - Notificaciones SIN token -> 401",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{notificacionesUrl}}/api/email/enviar?to=destino@correo.cl&subject=x&body=x"
      }
    },
    {
      "name": "13 - RabbitMQ admin: crear cola CON token ADMIN -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rabbit/queues",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"demo.postman\",\n  \"durable\": true,\n  \"deadLetterExchange\": \"pedidos.dlx\",\n  \"deadLetterRoutingKey\": \"demo.postman.dlq\"\n}"
        }
      }
    },
    {
      "name": "14 - RabbitMQ admin: cola con nombre vacio -> 400 (validacion)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rabbit/queues",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"durable\": true\n}"
        }
      }
    },
    {
      "name": "15 - RabbitMQ admin: ver la cola creada -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/rabbit/queues/demo.postman"
      }
    },
    {
      "name": "16 - RabbitMQ admin: eliminar la cola -> 204",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/rabbit/queues/demo.postman"
      }
    },
    {
      "name": "17 - RabbitMQ admin SIN token -> 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/rabbit/queues",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"x\"\n}"
        }
      }
    }
  ]
}